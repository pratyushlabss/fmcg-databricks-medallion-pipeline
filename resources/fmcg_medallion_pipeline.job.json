{
  "name": "fmcg_medallion_pipeline",
  "run_as": {
    "user_name": "pratyush@thecollectiveminds.com"
  },
  "format": "MULTI_TASK",
  "max_concurrent_runs": 1,
  "timeout_seconds": 0,
  "queue": {
    "enabled": true
  },
  "git_source": {
    "git_url": "https://github.com/pratyushlabss/fmcg-databricks-medallion-pipeline.git",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "trigger": {
    "pause_status": "UNPAUSED",
    "file_arrival": {
      "url": "/Volumes/fmcg_catalog/bronze/raw_files/"
    }
  },
  "tasks": [
    {
      "task_key": "ingest_bronze",
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "notebooks/01_bronze_ingestion.py",
        "source": "GIT"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "disabled": false
    },
    {
      "task_key": "transform_silver",
      "depends_on": [
        {
          "task_key": "ingest_bronze"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "notebooks/02_silver_cleansing.py",
        "source": "GIT"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "disabled": false
    },
    {
      "task_key": "build_gold_star_schema",
      "depends_on": [
        {
          "task_key": "transform_silver"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "notebooks/03_gold_star_schema.py",
        "source": "GIT"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "disabled": false
    },
    {
      "task_key": "validate_gold_integrity",
      "depends_on": [
        {
          "task_key": "build_gold_star_schema"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "sql_task": {
        "file": {
          "path": "sql/04_validate_gold_integrity.sql",
          "source": "GIT"
        },
        "warehouse_id": "57c8b43439eca3f5"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "disabled": false
    }
  ]
}